#!/bin/sh
# Mint, list and revoke Tura sync credentials for a web administration screen.
#
# WHY THIS EXISTS AND IS NOT A SUDOERS LINE ON `notes-server` ITSELF. The data
# directory is 0700 and owned by `notes`, so the web user cannot run the CLI at
# all; and `token create` writes the secret to a NEW file, mode 0600, owned by
# whoever ran it — which the web user then cannot read. Granting
# `(notes) NOPASSWD: /usr/local/bin/notes-server token create *` therefore buys
# a file nobody can open. The secret has to come back over the pipe, and
# something has to remove the file afterwards. That is this script.
#
# It also sets NOTES_SERVER_DATA, which sudo strips, and validates its own
# arguments — the caller is a web application, so "the caller validated it" is
# not a property this side may assume.
#
# INSTALL (on the server, as root):
#   install -m 0755 server/cotenant/tura-credential /usr/local/bin/tura-credential
#   printf '%s\n' 'www-data ALL=(notes) NOPASSWD: /usr/local/bin/tura-credential' \
#     > /etc/sudoers.d/tura-credential
#   chmod 0440 /etc/sudoers.d/tura-credential && visudo -c
#
# The grant is one reviewed script with no path argument, never the CLI with a
# wildcard. Whoever holds the web user can mint credentials — which is the point
# of the screen — but cannot choose where a secret is written.
#
# USAGE (always through: sudo -u notes tura-credential …):
#   tura-credential list
#   tura-credential create LABEL WORKSPACE PERMISSIONS   # prints the secret
#   tura-credential revoke UUID
#
# `create` prints the secret on stdout, once. It is never stored anywhere this
# script can be asked for it again; a lost secret is revoked and replaced.
set -eu

NOTES_SERVER_DATA="${TURA_CREDENTIAL_DATA:-/var/lib/notes-server}"
export NOTES_SERVER_DATA
BINARY="${TURA_CREDENTIAL_BINARY:-/usr/local/bin/notes-server}"

die() { echo "tura-credential: $1" >&2; exit 2; }

# The whole allowlist, spelled out. A regular expression that accepts "anything
# comma-separated and lowercase" also accepts a permission invented later, and
# the failure would be a credential quietly holding more than the screen offered.
check_permissions() {
    echo "$1" | tr ',' '\n' | while read -r permission; do
        case "$permission" in
            read|create|update|move|delete|search) ;;
            *) exit 1 ;;
        esac
    done
}

command="${1:-}"
case "$command" in
    list)
        [ "$#" -eq 1 ] || die "list takes no arguments"
        exec "$BINARY" token list
        ;;
    create)
        [ "$#" -eq 4 ] || die "create takes LABEL WORKSPACE PERMISSIONS"
        label="$2"; workspace="$3"; permissions="$4"
        echo "$label" | grep -Eq '^[A-Za-z0-9_-]{1,64}$' || die "invalid label"
        echo "$workspace" | grep -Eq '^[a-z0-9_-]{1,64}$' || die "invalid workspace"
        echo "$permissions" | grep -Eq '^[a-z,]{1,64}$' || die "invalid permissions"
        check_permissions "$permissions" || die "unknown permission"

        # Exclusive, private, and removed whatever happens next: the secret's
        # only durable copy is the one the caller is about to be handed.
        # A full template, not `mktemp -t`: BSD appends its own suffix to a `-t`
        # prefix and GNU deprecates the flag, so the two produce different names
        # for the same line. This form means the same thing on both.
        output="$(mktemp "${TMPDIR:-/tmp}/tura-credential.XXXXXX")"
        rm -f "$output"
        trap 'rm -f "$output"' EXIT INT TERM
        # Scope is always the whole workspace. A subfolder scope is a real
        # feature of the server and not of this screen; adding it here without
        # the screen to choose it would be a flag nobody sets correctly.
        "$BINARY" token create "$label" "$workspace" . "$permissions" "$output" >/dev/null
        cat "$output"
        ;;
    revoke)
        [ "$#" -eq 2 ] || die "revoke takes UUID"
        echo "$2" | grep -Eiq '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' \
            || die "invalid credential id"
        exec "$BINARY" token revoke "$2"
        ;;
    *)
        die "usage: tura-credential list | create LABEL WORKSPACE PERMISSIONS | revoke UUID"
        ;;
esac
